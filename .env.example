# Copy this file to ".env" and add an API key to turn on the AI engine.
# Without any key, Triperly still works — it uses the built-in rules engine.

# Which AI provider to use: "claude" (default), "gemini", or "auto".
# "auto" uses whichever key below is set, preferring Claude.
AI_PROVIDER=claude

# --- Claude (Anthropic) — the default, matches the pitch deck's cost model ---
# Get a key at https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=
# Sonnet 4.6 is the cost/quality sweet spot (~$0.024/itinerary, per the deck).
# claude-opus-4-8 for the hardest planning, claude-haiku-4-5 to cut cost.
CLAUDE_MODEL=claude-sonnet-4-6

# --- Gemini (Google) — alternative provider; set AI_PROVIDER=gemini to use ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash is Google's low-cost, high-volume tier.
# Pricing: https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-2.5-flash

# --- Google Places (live venue data) — optional ---
# When set, Triperly pulls real venues (ratings, locations, kid attributes) from
# the Google Places API instead of the seed data/chicago.json. Without it, the
# curated seed data is used.
# Get a key at https://console.cloud.google.com  ->  enable "Places API (New)"
# and enable billing (Google gives a recurring monthly credit).
GOOGLE_PLACES_API_KEY=

# Port for local development
PORT=3000

# =============================================================================
# Accounts, persistence & social — all OPTIONAL. With none of these set, Triperly
# runs exactly as before: guest mode, on-device storage, no login. Add them to
# turn on accounts, saved trips, reviews, and sharing. Keep real secrets OUT of
# the repo (this file is a template; copy to .env).
# =============================================================================

# --- Datastore ---------------------------------------------------------------
# Default (unset): built-in SQLite at data/tripit.db — zero setup, great for a
# single instance. Set DATABASE_URL to use Postgres instead (recommended for a
# real deployment, since Render's free web disk is ephemeral).
# DATABASE_URL=postgres://user:pass@host:5432/tripit?sslmode=require
# SQLITE_PATH=./data/tripit.db        # optional override for the SQLite file

# --- Sessions ----------------------------------------------------------------
# Signs the short-lived OAuth state cookie. Use a long random value in prod:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public origin, used to build OAuth redirect URIs. Locally this can be
# http://localhost:3000; in prod set your real URL (e.g. https://tripit.onrender.com).
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated emails allowed to moderate reviews (hide/remove/restore).
ADMIN_EMAILS=

# Demo sign-in (for pitches/previews). When "1", any social button that isn't
# really configured below becomes a SIMULATED login — it creates a real demo
# account + session so reviews and groups work, with no OAuth setup and no cost.
# Each provider yields a distinct "demo family" (handy for demoing a group).
# Leave unset (or "0") for the real product once real providers are configured.
DEMO_AUTH=

# Simulated bookings (flights, hotels, rides, transit, restaurant tables). ON by
# default — a tap returns a realistic confirmation code + saved reservation, all
# clearly labeled "Demo", with no payment and no provider account. The deep links
# (Google Flights/Maps, Uber, OpenTable) are real and free. Set DEMO_BOOKINGS=0
# (and wire the providers below) to take real bookings. See docs/PLAN.md.
DEMO_BOOKINGS=1

# Apple Wallet passes for reservations. ON by default — each reservation gets an
# in-app Wallet pass + "Add to Apple Wallet" (simulated, labeled demo). Real
# installable .pkpass passes need an Apple Pass Type ID cert (APPLE_PASS_* below);
# set those + DEMO_WALLET=0 for real passes.
DEMO_WALLET=1

# --- Social login (OAuth) ----------------------------------------------------
# Each provider activates only when BOTH its id and secret are present; its
# button appears automatically. Instagram/TikTok are NOT login providers — they
# are share targets (handled client-side via the Web Share API).

# Google — https://console.cloud.google.com → Credentials → OAuth client (Web).
# Authorized redirect URI: <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — https://developers.facebook.com → app → Facebook Login.
# Valid OAuth redirect URI: <PUBLIC_BASE_URL>/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Sign in with Apple — https://developer.apple.com (Services ID + a Sign-in key).
# Return URL: <PUBLIC_BASE_URL>/api/auth/apple/callback
# APPLE_CLIENT_ID is the Services ID; APPLE_PRIVATE_KEY is the .p8 contents
# (paste with real newlines, or as one line using \n between lines).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Real booking providers (approval-gated phase 2) -------------------------
# All OPTIONAL and unset by default — bookings stay simulated (DEMO_BOOKINGS=1)
# and the free deep links (Google Flights/Maps, Uber, OpenTable) already work.
# Each real provider needs a partner/business account and approval (like native
# social posting). When approved, wire the relevant key(s), set DEMO_BOOKINGS=0,
# and replace simulateBooking() in lib/bookings.js with the provider call.
UBER_CLIENT_ID=
UBER_SERVER_TOKEN=
OPENTABLE_PARTNER_KEY=
FLIGHTS_API_KEY=
HOTELS_API_KEY=

# Apple Wallet — Pass Type ID certificate for real, installable .pkpass passes
# (phase 2). Reuses APPLE_TEAM_ID above. APPLE_PASS_CERT/KEY are the Pass Type ID
# cert + private key (PEM; paste with real newlines or \n). Set DEMO_WALLET=0 once
# wired. Until then, passes are simulated in-app.
APPLE_PASS_TYPE_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
