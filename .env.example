# Copy this file to ".env" and fill in your key to turn on the AI engine.
# Without a key, TripIt still works — it uses the built-in rules engine.

# Get a key at https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=

# Which Claude model generates itineraries. Sonnet 4.6 is the cost/quality
# sweet spot for this (matches the unit economics in the pitch deck).
# Bump to claude-opus-4-8 for the hardest planning, or claude-haiku-4-5 to cut cost.
CLAUDE_MODEL=claude-sonnet-4-6

# Port for local development
PORT=3000
